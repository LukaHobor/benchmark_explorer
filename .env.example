# Copy to .env (gitignored) and fill in. pipeline/update.py and every script read it.

# LLM for the benchmark gate and the field fill, always through a Batch API.
#   openai      OpenAI Batch API: needs OPENAI_API_KEY; OPENAI_MODEL (default gpt-5-mini-2025-08-07)
#   openrouter  OpenRouter Batch API: needs OPENROUTER_API_KEY; OPENROUTER_MODEL (default
#               openai/gpt-6-luna), pinned to OPENROUTER_PROVIDER (default openai), no fallbacks
LLM_BACKEND=openai
OPENAI_API_KEY=
OPENAI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_PROVIDER=
# OpenRouter guards: spend cap per job in USD (default 10), output-token cap per request
# (default 2048), attempts per failed request or chunk (default 3), chunks in flight (default 3)
LLM_MAX_USD=
LLM_MAX_OUTPUT_TOKENS=
LLM_MAX_ATTEMPTS=
LLM_MAX_INFLIGHT=

# Strongly recommended: GitHub search at 30 req/min instead of 10, and needed for
# re-checking deferred repos. A fine-grained token with no permissions is enough.
# (Falls back to `gh auth token` if the GitHub CLI is logged in.)
GITHUB_TOKEN=

# Free key, needed to page past OpenAlex's first 100 results: https://openalex.org/settings/api
OPENALEX_API_KEY=

# Optional: Semantic Scholar API key, avoids 429s on the shared public pool
S2_API_KEY=
